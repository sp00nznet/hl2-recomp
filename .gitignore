# Game files (not redistributable)
*.iso
*.xbe
*.zip
*.7z
game/*.xbe

# Build artifacts
build/
build-msvc/
bin/
*.obj
*.lib
*.exe
*.pdb
*.ilk
*.map

# Generated recompiled code -- 1.3M lines, reproducible from the XBE in ~30s
# via regen.sh. Committing it would make every toolkit change an unreadable diff.
src/game/recomp/gen/
# The loader's generated C, same rule: derived from default.xbe, so it is
# regenerable (./regen_loader.sh --disasm) and does not belong here.
src/loader/recomp/gen/

# Pipeline intermediates
build/disasm/
build/func_id/
build/recomp/

# Runtime feedback dumps
icall_targets.dump
run_out.txt
run_err.txt

__pycache__/
*.pyc

# Extracted disc contents (not redistributable)
game/GameMedia/
game/LoaderMedia/
game/*.xz_
*.xzp

# Reference source checkouts (clone them yourself, see README)
ref/

# Runtime output: HDD partition images (multi-GB), logs, save data
saves/
run*.log
*_err.log
xbox_kernel.log
fb*.bmp

# Everything derived from the retail XBE. All of it is regenerated by
# regen.sh in seconds, and none of it belongs in a public repo:
#   hl2_analysis.json  section table + kernel imports
#   rtti_seeds.json    12,288 vtable-derived function addresses
#   rtti_names.json    11,520 class names lifted out of the retail RTTI
# config/seed_functions.json is deliberately NOT here: a runtime discovery
# cannot be re-derived without running the game.
game/*.json
f850.txt
s.log
s_all.log
r.log
game/UDATA/
game/TDATA/
f301.txt
sp*.log
r17.log
build-abi/
